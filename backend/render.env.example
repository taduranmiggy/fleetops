# FleetOpt — paste into Render → fleetops-api → Environment if you are not using
# the repository-root render.yaml Blueprint. Never commit real secrets.
#
# The Blueprint already generates SECRET_KEY and MYSQL_PASSWORD and wires
# MYSQL_HOST to the private MySQL service. run_server.py then composes DATABASE_URL.

APP_ENV=production
SECRET_KEY=REPLACE_WITH_32_PLUS_CHAR_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REQUIRE_MIGRATIONS=true
MIGRATION_MAX_ATTEMPTS=60
MIGRATION_RETRY_SECONDS=5

MYSQL_HOST=fleetops-mysql
MYSQL_PORT=3306
MYSQL_DATABASE=fleetopt
MYSQL_USER=fleetopt
MYSQL_PASSWORD=REPLACE_WITH_RENDER_MYSQL_PASSWORD

FRONTEND_URL=https://fleetops.netlify.app
CORS_ORIGINS=https://fleetops.netlify.app
UPLOADS_ROOT=/app/uploads
USE_CLERK_AUTH=false
DIESEL_PRICE_PHP_PER_LITER=74.75
TOLL_FEES_PHP_PER_TRIP=0

EMAIL_FROM=FleetOpt <noreply@deliverexapp.com>
RESEND_API_KEY=
FEEDBACK_INBOX_EMAIL=
